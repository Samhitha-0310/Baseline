# SMTP sends the branded HTML inquiry email. Leave blank to keep FormSubmit,
# which cannot use a custom HTML template. Gmail requires an app password.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=baselinecorp1@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM="Baseline Corp <baselinecorp1@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Inbox that receives inquiries once SMTP is set.
CONTACT_TO=baselinecorp1@gmail.com

# Required to read saved inquiries: Authorization: Bearer <token>
ADMIN_TOKEN=

# Optional overrides
# PORT=4318
# HOST=127.0.0.1
# DATABASE_PATH=data/inquiries.sqlite
